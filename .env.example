# --- Hosting on Vercel ---------------------------------------------------
# Turso database (turso.tech). Leave unset locally to use ~/.comment-picker/picker.db
# TURSO_DATABASE_URL=libsql://comment-picker-<you>.turso.io
# TURSO_AUTH_TOKEN=
# Admin password for the hosted app. Leave unset locally (no login screen).
# ADMIN_PASSWORD=

# Instagram long-lived access token (or paste it on the Settings page instead)
IG_ACCESS_TOKEN=

# Defaults work for "Instagram API with Instagram Login".
# If you connect via a Facebook Page instead, use:
#   IG_GRAPH_BASE=https://graph.facebook.com
#   IG_USER_ID=<instagram business account id>
# IG_GRAPH_BASE=https://graph.instagram.com
# IG_USER_ID=me

# Optional: Claude reads score predictions the parser can't read with certainty
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: where the SQLite database lives (default ~/.comment-picker/picker.db).
# Keep it outside the project folder, or the dev server reloads the page in a loop.
# DATABASE_PATH=
